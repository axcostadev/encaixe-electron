{
	"name": "cutting-room",
	"version": "0.0.3",
	"description": "A aplicação para adminstrar os cadastro de modelos e componentes.",
	"main": "./out/main/index.js",
	"author": "Aincrad",
	"homepage": "https://aincrad.dev.br/",
	"workspaces": [
		"src/renderer/machine-work-state/frontend"
	],
	"scripts": {
		"biome": "biome check src",
		"biome:format": "biome format src",
		"typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
		"typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
		"typecheck": "npm run typecheck:node && npm run typecheck:web",
		"build:workstate": "cd src/renderer/machine-work-state/frontend && npm install && npm run build:lib",
		"start": "electron-vite preview",
		"dev": "electron-vite dev",
		"build": "npm run build:workstate && npm run typecheck && electron-vite build",
		"postinstall": "electron-builder install-app-deps",
		"build:unpack": "npm run build && electron-builder --dir",
		"build:win": "npm run build && electron-builder --win",
		"build:portable": "npm run build && electron-builder --win portable",
		"build:mac": "electron-vite build && electron-builder --mac",
		"build:linux": "electron-vite build && electron-builder --linux",
		"migrate:economia": "node ./scripts/migrate_economia_to_appdb.js"
	},
