{
	"extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
	"references": [
		{
			"path": "src/renderer/machine-work-state/frontend/tsconfig.json"
		}
	],
	"include": [
		"src/renderer/src/env.d.ts",
		"src/renderer/src/**/*",
		"src/renderer/src/**/*.tsx",
		"src/preload/*.d.ts"
	],
	"compilerOptions": {
		// composite projects require existing declaration output; we don't build
		// declarations in the web bundle so turn composite off and disable
		// declaration emission to avoid TS6305 errors when no emit is used.
		"composite": false,
		"declaration": false,
		"jsx": "react-jsx",
		"baseUrl": ".",
		"allowImportingTsExtensions": true,
		"paths": {
			"@renderer/*": ["src/renderer/src/*"],
			"machine-work-state": [
				"src/renderer/machine-work-state/frontend/src",
				"dist/machine-work-state/machine-work-state.es.js"
			]
		},
		"skipLibCheck": true
	}
}
